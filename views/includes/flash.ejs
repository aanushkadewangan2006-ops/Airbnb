
<%if(success && success.length){ %>
<div class="alert alert-success alert-dismissible fade show offset-3  w-50 text-center" role="alert">
    <%= success %>
<button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<%if(error && error.length){ %>
<div class="alert alert-danger alert-dismissible fade show offset-3  w-50 text-center" role="alert">
    <%= error %>
<button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>